{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: follows the menu, manages the Instagram token and the WordPress settings, lists recent posts and creates WordPress drafts.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-set-layout-menu",
    "allow-open-in-browser",
    "allow-prepare-draft",
    "allow-suggest-slug",
    "allow-token-status",
    "allow-save-token",
    "allow-refresh-token",
    "allow-renew-token-if-due",
    "allow-clear-token",
    "allow-list-posts",
    "allow-get-wordpress-settings",
    "allow-save-wordpress-settings",
    "allow-clear-wordpress-settings",
    "allow-list-categories",
    "allow-create-wordpress-draft"
  ]
}
